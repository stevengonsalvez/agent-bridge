{
  "name": "debug-bridge-browser-sidecar",
  "version": "0.1.0",
  "description": "CDP-capable browser sidecar for debug-bridge",
  "author": "stevengonsalvez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stevengonsalvez/agent-bridge"
  },
  "keywords": ["debug", "bridge", "ai", "agent", "browser", "cdp", "playwright"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "debug-bridge-types": "workspace:*",
    "playwright": "^1.57.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}

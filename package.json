{
  "name": "debug-bridge",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "pnpm run type-check && pnpm run test:e2e",
    "test:e2e": "pnpm run build && node scripts/run-demo-validations.mjs",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "publish:all": "pnpm -r publish --access public"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@types/node": "^22.10.2",
    "playwright": "^1.57.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  }
}
